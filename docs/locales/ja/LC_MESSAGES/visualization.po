"Grayscale+Hex)"

#: ../../visualization.rst:117
msgid "``i``"
msgstr "``i``"

#: ../../visualization.rst:118
msgid "Inspect details of the currently executing instruction"
msgstr "現在実行中の命令の詳細情報を表示"

#: ../../visualization.rst:119
msgid "``h`` or ``?``"
msgstr "``h`` または ``?``"

#: ../../visualization.rst:120
